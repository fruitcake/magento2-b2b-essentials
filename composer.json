{
  "name": "fruitcake/magento2-b2b-essentials",
  "description": "Magento2 B2B Essentials.",
  "keywords": [
    "magento",
    "magento2",
    "b2b",
    "registration"
  ],
  "license": [
    "MIT"
  ],
  "type": "magento2-module",
  "authors": [
    {
      "name": "Fruitcake",
      "email": "info@fruitcake.nl"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Fruitcake\\B2BEssentials\\": ""
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-master": "1.3-dev"
    }
  },
  "require-dev": {
    "magento/framework": "^103.0",
    "magento/module-catalog": "^104.0",
    "magento/module-customer": "^103.0",
    "magento/module-webapi": "^100.4",
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Fruitcake\\B2BEssentials\\Test\\": "Test/"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://mirror.mage-os.org/",
      "only": [
        "magento/*"
      ]
    }
  ],
  "config": {
    "allow-plugins": {
      "magento/composer-dependency-version-audit-plugin": false,
      "magento/magento-composer-installer": false,
      "laminas/laminas-dependency-plugin": false
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
